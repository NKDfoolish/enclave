# Local development only. Copy to .env and adjust if ports clash.
POSTGRES_USER=enclave
POSTGRES_PASSWORD=enclave
POSTGRES_DB=enclave
POSTGRES_PORT=5432
# 6379 is often taken by another local Redis or an SSH tunnel.
REDIS_PORT=6380
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

DATABASE_URL=postgres://enclave:enclave@localhost:5432/enclave?sslmode=disable
REDIS_URL=redis://localhost:6380/0
RAG_GRPC_ADDR=localhost:50051

# Core API
API_HTTP_ADDR=:8080
API_SHUTDOWN_TIMEOUT=10s
# Exposes /v1/debug/* routes. Local development only.
API_ENABLE_DEBUG_ROUTES=true
# Login tokens (ADR 0002). The signing key is a base64 Ed25519 seed: openssl rand -base64 32
# DEVELOPMENT ONLY key below; every deployed environment must use its own secret.
API_JWT_SIGNING_KEY=ArYMsSrgfvqvccx//yPDW/ciJ8b8YtFUSFHXVUEtXRQ=
API_ACCESS_TOKEN_TTL=15m
API_REFRESH_TOKEN_TTL=168h
# Secure cookies must stay on outside local plain-HTTP development.
API_SECURE_COOKIES=false

# Object storage for original documents (RustFS locally, Amazon S3 in production).
OBJECTSTORE_PORT=9000
OBJECTSTORE_ENDPOINT=http://localhost:9000
# Address browsers use for presigned URLs; defaults to OBJECTSTORE_ENDPOINT.
OBJECTSTORE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECTSTORE_BUCKET=enclave-documents
OBJECTSTORE_ACCESS_KEY=enclave
# DEVELOPMENT ONLY.
OBJECTSTORE_SECRET_KEY=enclave-dev-secret
API_MAX_DOCUMENT_BYTES=26214400

# Integration tests (`make test` creates and migrates this database).
TEST_DATABASE_URL=postgres://enclave:enclave@localhost:5432/enclave_test?sslmode=disable
TEST_REDIS_URL=redis://localhost:6380/15
TEST_OBJECTSTORE_ENDPOINT=http://localhost:9000
TEST_OBJECTSTORE_ACCESS_KEY=enclave
TEST_OBJECTSTORE_SECRET_KEY=enclave-dev-secret
