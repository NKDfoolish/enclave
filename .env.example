# Local development only. Copy to .env and adjust if ports clash.
POSTGRES_USER=enclave
POSTGRES_PASSWORD=enclave
POSTGRES_DB=enclave
POSTGRES_PORT=5432
# 6379 is often taken by another local Redis or an SSH tunnel.
REDIS_PORT=6380
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

DATABASE_URL=postgres://enclave:enclave@localhost:5432/enclave?sslmode=disable
REDIS_URL=redis://localhost:6380/0
RAG_GRPC_ADDR=localhost:50051

# Core API
API_HTTP_ADDR=:8080
API_SHUTDOWN_TIMEOUT=10s
# Exposes /v1/debug/* routes. Local development only.
API_ENABLE_DEBUG_ROUTES=true
