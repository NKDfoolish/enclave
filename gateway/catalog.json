{
  "providers": [
    {
      "name": "ollama",
      "kind": "openai",
      "base_url": "http://localhost:11434/v1",
      "external": false
    },
    {
      "name": "nvidia",
      "kind": "openai",
      "base_url": "https://integrate.api.nvidia.com/v1",
      "api_key_env": "NVIDIA_API_KEY",
      "external": true,
      "send_input_type": true
    },
    {
      "name": "anthropic",
      "kind": "anthropic",
      "base_url": "https://api.anthropic.com",
      "api_key_env": "ANTHROPIC_API_KEY",
      "external": true
    }
  ],
  "models": [
    {
      "alias": "chat-fast",
      "kind": "chat",
      "routes": [
        { "provider": "ollama", "model": "llama3.2:3b" },
        { "provider": "nvidia", "model": "nvidia/nemotron-3.5-bolt-e4b" }
      ]
    },
    {
      "alias": "chat-smart",
      "kind": "chat",
      "routes": [
        { "provider": "nvidia", "model": "mistralai/mistral-large-4-1t-a52b" },
        { "provider": "anthropic", "model": "claude-opus-5-5", "input_usd_per_mtok": 4, "output_usd_per_mtok": 20 },
        { "provider": "ollama", "model": "llama3.2:3b" }
      ]
    },
    {
      "alias": "chat-judge",
      "kind": "chat",
      "routes": [
        { "provider": "nvidia", "model": "nvidia/nemotron-3.5-lightning-30b-a3b" },
        { "provider": "ollama", "model": "llama3.2:3b" }
      ]
    },
    {
      "alias": "embed-local",
      "kind": "embedding",
      "routes": [
        {
          "provider": "ollama",
          "model": "nomic-embed-text",
          "input_prefixes": { "query": "search_query: ", "passage": "search_document: " }
        }
      ]
    },
    {
      "alias": "embed-nvidia",
      "kind": "embedding",
      "routes": [{ "provider": "nvidia", "model": "nvidia/nemotron-3.5-embed-1b" }]
    }
  ]
}
